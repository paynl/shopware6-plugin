# Public shop URL Playwright and PAY. use. Must end with a slash.
# env:up replaces both URLs with the tunnel. They must be the same host:
# Shopware builds administration asset URLs from ADMIN_API_URL.
APP_URL=http://127.0.0.1:8080/
ADMIN_API_URL=http://127.0.0.1:8080/

SHOPWARE_ADMIN_USERNAME=admin
# Overwritten by scripts/e2e-env.sh on each env:up (random per run). Required for admin UI tests.
SHOPWARE_ADMIN_PASSWORD=

# EUR + English storefront (Shopware ATS locale).
LANG=en-DE

# PAY. test credentials. In GitHub Actions these come from repository secrets.
PAY_TOKEN_CODE=
PAY_API_TOKEN=
PAY_SERVICE_ID=
# Sales-location secret from my.pay.nl (Settings → Sales location). Not the API token.
PAY_SANDBOX_SECRET=

# Checkout label of the PAY. method to select. Default is the uniform PAY. method.
PAY_PAYMENT_METHOD="Pay by PAY."

# Fail the test if Shopware does not reach "paid" within this time.
PAY_STATUS_TIMEOUT_MS=120000

# Used by scripts/e2e-env.sh
SHOPWARE_VERSION=6.7.10.0
SHOPWARE_PORT=8080
# Optional. When set, the environment script uses ngrok instead of cloudflared.
# NGROK_AUTHTOKEN=
